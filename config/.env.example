# Copy through: python3 scripts/setup.py init
# Values stay outside Git. Empty values mean disabled. Process environment wins.
# Smart Search: xAI OR a search-capable OpenAI-compatible endpoint.
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_TOOLS=web_search,x_search
OPENAI_COMPATIBLE_API_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Structured search APIs (each independently usable).
TAVILY_API_KEY=
EXA_API_KEY=
# Standalone semantic query planner (agent mode needs no LLM key).
DEEP_RESEARCH_PLANNER_BASE_URL=https://api.openai.com/v1
DEEP_RESEARCH_PLANNER_API_KEY=
DEEP_RESEARCH_PLANNER_MODEL=
# Optional GPT Researcher synthesis; embedding API access also required.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FAST_LLM=
SMART_LLM=
EMBEDDING=openai:text-embedding-3-small
# Optional paths; executables otherwise discovered in PATH.
DEEP_RESEARCH_SMART_SEARCH_BIN=
DEEP_RESEARCH_BROWSER_BIN=
DEEP_RESEARCH_LAST30_SCRIPT=
# last30days: platform-specific credentials (see docs/SETUP.md).
SCRAPECREATORS_API_KEY=
APIFY_API_TOKEN=
OPENROUTER_API_KEY=
PARALLEL_API_KEY=
BRAVE_API_KEY=
BSKY_HANDLE=
BSKY_APP_PASSWORD=
TRUTHSOCIAL_TOKEN=
# Feishu is opt-in, authenticated using lark-cli. No default recipient.
FEISHU_RESEARCH_NOTIFY_USER_ID=
FEISHU_RESEARCH_NOTIFY_CHAT_ID=
